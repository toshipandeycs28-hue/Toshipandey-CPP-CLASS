#include <iostream>
#include <vector>
using namespace std;

int main()
{
    int n;

    cout << "Enter number of characters: ";
    cin >> n;

    vector<char> v(n);

    cout << "Enter " << n << " characters: ";

    for (int i = 0; i < n; i++)
    {
        cin >> v[i];
    }

    int vowels = 0;
    int consonants = 0;

    for (int i = 0; i < n; i++)
    {
        char ch = v[i];

        if (ch == 'a' || ch == 'e' || ch == 'i' ||
            ch == 'o' || ch == 'u' ||
            ch == 'A' || ch == 'E' || ch == 'I' ||
            ch == 'O' || ch == 'U')
        {
            vowels++;
        }
        else
        {
            consonants++;
        }
    }

    cout << "Number of vowels = " << vowels << endl;
    cout << "Number of consonants = " << consonants << endl;

    return 0;
}